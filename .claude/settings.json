{
  "coauthorship": true,
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "lup@lup-template-repository": true,
    "pyright-lsp@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_THISTLE_GREBE": "default",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "extraKnownMarketplaces": {
    "lup-template-repository": {
      "source": {
        "path": "./.claude/plugins",
        "source": "directory"
      }
    }
  },
  "fileSuggestion": {
    "command": ".claude/plugins/lup/scripts/file_suggest.sh",
    "type": "command"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Skill(lup:hooks)",
      "ExitWorktree",
      "Read(./.claude/settings.json.local*)",
      "Read(./sync.json.local)",
      "mcp__notes",
      "mcp__sandbox",
      "mcp__codeintel",
      "mcp__coordination",
      "mcp__ledger"
    ],
    "deny": [
      "Read(./**/secrets*.local)",
      "Read(./**/*.secret.local)",
      "Read(~/.ssh/**)",
      "Read(~/.ssh)",
      "Read(~/.gnupg/**)",
      "Read(~/.gnupg)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.pypirc)",
      "Read(//proc/*/environ)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/lup/companions/*/dashboard/token)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/claude-config/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(//**/codex-home/auth.json)",
      "Read(//tmp/lup-wake/**)",
      "Read(//tmp/lup-wake)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "ssh *",
      "git *",
      "gh *",
      "uv run lup-devtools harness *",
      "uv run lup-devtools resolve *",
      "uv run lup-devtools git worktree *",
      "uv run lup-devtools git pr *",
      "uv run lup-devtools git conflict *",
      "uv run lup-devtools git hooks *",
      "uv run lup-devtools dev undo *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "/tmp"
      ]
    },
    "network": {
      "allowedDomains": [
        "docs.claude.com",
        "code.claude.com",
        "platform.claude.com",
        "docs.anthropic.com",
        "claude.com",
        "www.claude.com",
        "claude.ai",
        "ai.pydantic.dev",
        "learn.chatgpt.com",
        "developers.openai.com",
        "github.com",
        "api.github.com",
        "githubusercontent.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "127.0.0.1",
        "localhost",
        "api.anthropic.com"
      ]
    }
  }
}

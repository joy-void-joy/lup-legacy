{
  "description": "Lup semantic permission policy, peer delivery, the calling subagent on each coordination call, the roster's changes at each prompt, this session's name for its work, a session's or subagent's departure as it ends, and a subagent's report waiting on its background work",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/policy.sh\" || exit 2",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|WebFetch|Edit|Write|SendMessage|ListAgents|Agent|Artifact|Skill|EnterWorktree"
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_delivery.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_caller.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__coordination__.*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_departure.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/subagent_cleanup.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_departure.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/subagent_cleanup.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/coordination_changes.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/carrier_drift.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/scripts/session_naming.sh\" || exit 0",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
